# dbt Environment Configuration
# Copy this to .env and configure with your credentials
# Never commit .env to version control

SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USER=your.email@nhs.net
SNOWFLAKE_ROLE=DBT_ADMIN
SNOWFLAKE_WAREHOUSE=WH_WNL_OLIDS_L
SNOWFLAKE_TARGET_DATABASE=OLIDS_ENGINEERING

# Optional explicit authenticator override, for example externalbrowser for SSO.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Snowflake password
SNOWFLAKE_PASSWORD=

# Snowflake programmatic access token
SNOWFLAKE_PAT=

# GitHub Actions uses the same key-pair secrets as dbt-analytics.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
