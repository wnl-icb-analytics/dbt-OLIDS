# dbt profiles template for dbt-olids
#
# SETUP:
# 1. Copy this file to 'profiles.yml'
# 2. Configure environment variables in .env (see env.example)
# 3. Never commit profiles.yml to git
#
# profiles.yml is git-ignored for security

dbt_olids:
  target: stable
  outputs:
    stable:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD', '') }}"
      token: "{{ env_var('SNOWFLAKE_PAT', '') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH', '') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      authenticator: "{{ env_var('SNOWFLAKE_AUTHENTICATOR', 'snowflake_jwt' if env_var('SNOWFLAKE_PRIVATE_KEY_PATH', '') else ('programmatic_access_token' if env_var('SNOWFLAKE_PAT', '') else ('username_password_mfa' if env_var('SNOWFLAKE_PASSWORD', '') else 'externalbrowser'))) }}"
      role: "{{ env_var('SNOWFLAKE_ROLE') }}"
      database: "{{ env_var('SNOWFLAKE_TARGET_DATABASE') }}"
      schema: OLIDS_BASE
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE') }}"
      threads: 8
      client_session_keep_alive: true
      query_tag: "dbt_olids_stable"
      connect_retries: 3
      connect_timeout: 10
      retry_all: true
